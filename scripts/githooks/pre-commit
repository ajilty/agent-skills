#!/usr/bin/env bash
# Leak guard for this public repo: identity allowlist + content blocklist.
# Activate once per clone: git config core.hooksPath scripts/githooks
#
# Content guard scans only ADDED lines of the staged diff against a private,
# never-tracked blocklist (shared with the dotfiles repo's guard). Missing
# blocklist -> warn, don't block, so contributors without one are unaffected.
set -euo pipefail

EXPECTED="ajilty <github@ajilty.com>"

strip_time() {
    local ident="$1"
    echo "${ident% * *}"
}

check() {
    local label="$1" who
    who=$(strip_time "$2")
    if [[ "$who" != "$EXPECTED" ]]; then
        echo "ERROR: identity guard tripped — commit blocked." >&2
        echo "  $label:   $who" >&2
        echo "  Expected: $EXPECTED" >&2
        echo "" >&2
        echo "This repo is public; commits must use the public identity." >&2
        echo "Check: git config --show-origin user.email" >&2
        exit 1
    fi
}

check "Author"    "$(git var GIT_AUTHOR_IDENT)"
check "Committer" "$(git var GIT_COMMITTER_IDENT)"

# ---------------------------------------------------------------------------
# Content guard.
# ---------------------------------------------------------------------------

BLOCKLIST_FILE="${AGENTIC_BLOCKLIST_FILE:-$HOME/.local/config/dotfiles/blocklist}"
STALE_DAYS=30

warn() { echo "WARN: $*" >&2; }

if [[ ! -f "$BLOCKLIST_FILE" ]]; then
    warn "content blocklist not present at $BLOCKLIST_FILE."
    warn "  Skipping content scan (identity guard still applied)."
    exit 0
fi

if [[ -n "$(find "$BLOCKLIST_FILE" -mtime +"$STALE_DAYS" -print 2>/dev/null)" ]]; then
    warn "content blocklist is more than $STALE_DAYS days old."
    warn "  Refresh it (dotfiles-blocklist-sync). Scanning with stale list."
fi

patterns=()
while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*$ ]] && continue
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    patterns+=("$line")
done < "$BLOCKLIST_FILE"

if [[ ${#patterns[@]} -eq 0 ]]; then
    warn "content blocklist is present but contains no patterns."
    exit 0
fi

diff_output=$(git diff --cached --no-color -U0)
if [[ -z "$diff_output" ]]; then
    exit 0
fi

# Only scan ADDED lines; removing a leak must never block. Strip +++ headers
# so file paths don't false-match.
content=$(echo "$diff_output" | grep -E '^\+' | grep -v '^+++' || true)

hits=()
for pattern in "${patterns[@]}"; do
    if echo "$content" | grep -qiF -- "$pattern"; then
        hits+=("$pattern")
    fi
done

if [[ ${#hits[@]} -gt 0 ]]; then
    echo "ERROR: content guard tripped — commit blocked." >&2
    echo "  The staged diff matches blocklist patterns:" >&2
    for p in "${hits[@]}"; do
        echo "    - $p" >&2
    done
    echo "" >&2
    echo "Affected files:" >&2
    echo "$diff_output" | grep -E '^\+\+\+ b/' | sed 's|^+++ b/|    |' >&2
    echo "" >&2
    echo "Edit the staged content or unstage the file. To inspect the blocklist:" >&2
    echo "  cat $BLOCKLIST_FILE" >&2
    exit 1
fi
